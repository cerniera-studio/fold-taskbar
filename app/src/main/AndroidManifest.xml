<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets the bar list every app with a launcher icon, and find the home screen app -->
    <queries>
        <!-- Icon packs, so the bar can use the icons on your home screen -->
        <package android:name="ginlemon.iconpackstudio" />
        <!-- Riserva (16 Nov 2026): the bar reads the battery for it, only when it is installed -->
        <package android:name="com.cerniera.riserva" />
        <!-- Nodo (18 Nov 2026): which apps its knots wait for, and telling it when one opens -->
        <package android:name="com.cerniera.nodo" />
        <provider android:authorities="com.cerniera.nodo.cues" />
        <intent><action android:name="org.adw.launcher.THEMES" /></intent>
        <intent><action android:name="com.novalauncher.THEME" /></intent>
        <intent><action android:name="com.gau.go.launcherex.theme" /></intent>
        <intent><action android:name="com.anddoes.launcher.THEME" /></intent>
        <intent><action android:name="com.teslacoilsw.launcher.THEME" /></intent>
        <intent><action android:name="com.dlto.atom.launcher.THEME" /></intent>
        <intent><action android:name="org.adw.launcher.icons.ACTION_PICK_ICON" /></intent>
        <intent><action android:name="ginlemon.smartlauncher.THEMES" /></intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.fede.launcher.THEME_ICONPACK" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.anddoes.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.teslacoilsw.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Fluido (18 Nov 2026): Lume's leaving soon reads the next event, once allowed in Settings -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Advanced tuning: the bar's show and hide animation, spring, and how it is called and held -->
        <activity
            android:name=".TuningActivity"
            android:exported="false"
            android:label="Advanced tuning" />

        <!-- Full-screen stepping stone for split screen and app pairs: Android only honours
             "open beside me" from a full-screen app -->
        <activity
            android:name=".SplitActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode"
            android:theme="@style/Crease" />

        <service
            android:name=".TaskbarService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/taskbar_service" />
        </service>
        <!-- Now playing (3 Nov 2026): Android only shows which music is playing to an app it
             trusts with notifications. Spia (16 Nov 2026) reads the notifications showing, in
             memory only, to light its lamps. Nothing is stored or sent -->
        <service
            android:name=".MediaListener"
            android:exported="true"
            android:label="Fold Taskbar: now playing and Spia"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- Quick Settings tile: shows whether the bar is running, and brings it back -->
        <service
            android:name=".TaskbarTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_taskbar"
            android:label="Taskbar"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>
    </application>
</manifest>
